{
  "version": 2,
  "framework": null,
  "cleanUrls": true,
  "redirects": [
    { "source": "/products", "destination": "/cakes", "permanent": true },
    { "source": "/products.html", "destination": "/cakes", "permanent": true },
    { "source": "/b2b", "destination": "/wholesale", "permanent": true },
    { "source": "/b2b.html", "destination": "/wholesale", "permanent": true },
    { "source": "/scan", "destination": "/menu", "permanent": false },
    { "source": "/qr-order", "destination": "/menu", "permanent": false }
  ],
  "rewrites": [
    { "source": "/cakes/:category/:id", "destination": "/product-detail.html?cat=:category&id=:id" },
    { "source": "/cakes/:id", "destination": "/product-detail.html?id=:id" },
    { "source": "/cakes", "destination": "/cakes.html" },
    { "source": "/wholesale", "destination": "/wholesale.html" },
    { "source": "/menu", "destination": "/menu.html" },
    { "source": "/delivery", "destination": "/menu.html" },
    { "source": "/order", "destination": "/menu.html" },
    { "source": "/order-online", "destination": "/menu.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/careers", "destination": "/careers.html" }
  ]
}
